{
  "permissions": {
    "ask": [
      "Edit(src/__tests__/households.ts)",
      "Write(src/__tests__/households.ts)",
      "Edit(docs/ADR.md)",
      "Write(docs/ADR.md)",
      "Edit(docs/CONTEXT.md)",
      "Write(docs/CONTEXT.md)",
      "Edit(params/**)",
      "Write(params/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Write(CONTEXT.md)",
      "Write(docs/adr/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.mjs\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-read.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.mjs\""
          }
        ]
      }
    ]
  }
}
